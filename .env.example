# Copy this file to .env and configure environment-specific secrets.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
PORT=5050
SECRET_KEY=replace_with_opaque_random_string__python_c_import_secrets_token_urlsafe_48

# MySQL Database Settings (Laragon / XAMPP / Production)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=cube_permutation

# Security & Session Settings
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
PERMANENT_SESSION_LIFETIME_DAYS=7

# File Upload Settings
MAX_CONTENT_LENGTH_MB=16
